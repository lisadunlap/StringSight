# OpenAI API key (required)
OPENAI_API_KEY=your-openai-key-here

# Optional: Other LLM provider keys
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here

# Optional: Email configuration for result notifications
# Currently using Gmail SMTP for correct sender address
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your.email@gmail.com
EMAIL_PASSWORD=your-app-password

# NOTE: Brevo API is currently disabled in email_service.py to ensure emails
# come from stringsightai@gmail.com instead of brevosend.com.
# Brevo may be re-enabled in the future for better deliverability.
# BREVO_API_KEY=your-brevo-key-here

# Optional: Cache configuration
# STRINGSIGHT_CACHE_DIR=/path/to/cache
# STRINGSIGHT_CACHE_MAX_SIZE=50GB
# STRINGSIGHT_DISABLE_CACHE=0

# Optional: Database URL (if not using Docker)
# DATABASE_URL=postgresql://user:password@localhost:5432/stringsight

# Optional: Redis URL (if not using Docker)
# REDIS_URL=redis://localhost:6379/0

# Optional: Storage configuration (if not using Docker)
# STORAGE_TYPE=s3
# S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
